# --- required ---
ANTHROPIC_API_KEY=sk-ant-...          # your key; agents for every customer run on it
JWT_SECRET=change-me-long-random      # signs login sessions
SECRET_KEY=change-me-long-random      # encrypts customers' connection credentials (never change after launch)
PUBLIC_URL=https://app.yourdomain.com # where the app is served
DATABASE_URL=postgres://user:pass@host:5432/aries   # or a folder path for embedded Postgres in dev

# --- your Stripe account: selling Aries subscriptions ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...       # endpoint: $PUBLIC_URL/api/stripe/webhook
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_SCALE=price_...

# --- Shopify Partner app: one-click "Connect with Shopify" ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=                   # redirect URL: $PUBLIC_URL/api/oauth/shopify/callback
SHOPIFY_API_VERSION=2026-07

# --- optional ---
MAX_CONCURRENT_RUNS=8                 # agent check-ins running at once across all customers
WEB_SEARCH=0                          # 1 lets agents search the web (billed per search)
PRICES={"claude-sonnet-5-5":[2,10]}   # override $/M tokens if Anthropic's prices change
